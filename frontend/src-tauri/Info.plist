<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Without a usage description WKWebView hides navigator.mediaDevices,
       so voice input fails with "Microphone not supported in this browser". -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Jarvis uses the microphone so you can talk to him.</string>
  <!-- Without this macOS never shows the Automation prompt, so the app is
       silently refused control of System Events and never appears under
       Privacy & Security -> Automation. -->
  <key>NSAppleEventsUsageDescription</key>
  <string>Jarvis controls other apps for you: opening and switching apps, and (only after you approve) typing, clicking and quitting.</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <!-- The desktop API URL is user-configurable, so it cannot be represented
         by Tauri's single, build-time exceptionDomain setting. Keep this
         exception scoped to WKWebView; native URLSession traffic retains ATS. -->
    <key>NSAllowsArbitraryLoadsInWebContent</key>
    <true/>
  </dict>
</dict>
</plist>
